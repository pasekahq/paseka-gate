{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasekahq.example.org/contracts/v1/wire/key-proof.schema.json",
  "title": "Key proof payload (JWS typ paseka-key-proof+jwt, signed by new_key)",
  "type": "object",
  "required": [
    "v",
    "iss",
    "new_key",
    "next_key_sha256",
    "previous_valid_until"
  ],
  "properties": {
    "v": {
      "$ref": "../common.schema.json#/$defs/v"
    },
    "iss": {
      "$ref": "../common.schema.json#/$defs/address",
      "description": "Sender address, the envelope iss."
    },
    "new_key": {
      "$ref": "../common.schema.json#/$defs/key_id",
      "description": "Equals data.new_key."
    },
    "next_key_sha256": {
      "$ref": "../common.schema.json#/$defs/sha256",
      "description": "Equals data.next_key_sha256."
    },
    "previous_valid_until": {
      "$ref": "../common.schema.json#/$defs/unix_time",
      "description": "Equals data.previous_valid_until."
    }
  }
}
