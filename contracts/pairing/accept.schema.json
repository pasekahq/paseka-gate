{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasekahq.example.org/contracts/v1/pairing/accept.schema.json",
  "title": "pair.accept payload (JWS typ paseka-pair+jwt, signed by the inviter key named in key)",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "iss",
    "aud",
    "key",
    "request_id",
    "request_sha256",
    "endpoint",
    "iat"
  ],
  "properties": {
    "v": {
      "$ref": "../common.schema.json#/$defs/v"
    },
    "type": {
      "const": "pair.accept"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/pairing_id"
    },
    "iss": {
      "$ref": "../common.schema.json#/$defs/address"
    },
    "aud": {
      "$ref": "../common.schema.json#/$defs/address"
    },
    "key": {
      "$ref": "../common.schema.json#/$defs/key_id",
      "description": "Inviter key, pinned by the invitee for iss; equals k of the pair URI."
    },
    "request_id": {
      "$ref": "../common.schema.json#/$defs/pairing_id"
    },
    "request_sha256": {
      "$ref": "../common.schema.json#/$defs/sha256"
    },
    "endpoint": {
      "$ref": "../common.schema.json#/$defs/https_url"
    },
    "iat": {
      "$ref": "../common.schema.json#/$defs/unix_time"
    },
    "next_key_sha256": {
      "$ref": "../common.schema.json#/$defs/sha256",
      "description": "Inviter's first rotation commitment: SHA-256 of its next 32-byte public key. Optional."
    }
  }
}
