{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasekahq.example.org/contracts/v1/mandate/jws-header.schema.json",
  "title": "Protected header of every paseka JWS",
  "type": "object",
  "required": [
    "alg",
    "kid",
    "typ"
  ],
  "properties": {
    "alg": {
      "const": "EdDSA"
    },
    "kid": {
      "$ref": "../common.schema.json#/$defs/key_id"
    },
    "typ": {
      "enum": [
        "paseka-mandate+sd-jwt",
        "paseka-envelope+jwt",
        "paseka-receipt+jwt",
        "paseka-pair+jwt",
        "paseka-key-proof+jwt"
      ]
    }
  },
  "additionalProperties": false
}
