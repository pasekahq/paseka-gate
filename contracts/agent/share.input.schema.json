{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasekahq.example.org/contracts/v1/agent/share.input.schema.json",
  "title": "share input",
  "type": "object",
  "properties": {
    "to": {
      "$ref": "../common.schema.json#/$defs/peer_handle"
    },
    "doc": {
      "$ref": "../common.schema.json#/$defs/doc_id"
    },
    "section": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "note": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\n\\r]*$",
      "description": "Further limits (no URLs, e-mails, encoded or digit runs) are enforced by the gate."
    },
    "in_reply_to": {
      "$ref": "../common.schema.json#/$defs/message_id"
    }
  },
  "required": [
    "to",
    "doc"
  ],
  "additionalProperties": false
}
